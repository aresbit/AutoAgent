#!/bin/sh
set -eu
umask 077

APP_DIR="${AUTOAGENT_APP_DIR:-/opt/autoagent}"
ELECTRON="$APP_DIR/desktop/electron"
DESKTOP_APP="$APP_DIR/desktop/resources/app"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/autoagent"
LOG_DIR="$STATE_HOME/logs"
LOG_FILE="$LOG_DIR/desktop.log"

export AUTOAGENT_ENGINE_DIR="${AUTOAGENT_ENGINE_DIR:-$APP_DIR/engine}"

[ -x "$ELECTRON" ] || { echo "AutoAgent: missing $ELECTRON" >&2; exit 1; }
[ -f "$DESKTOP_APP/main.js" ] || { echo "AutoAgent: missing $DESKTOP_APP/main.js" >&2; exit 1; }

mkdir -p "$LOG_DIR"

WAYLAND_OK=0
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  case "$WAYLAND_DISPLAY" in
    /*) WAYLAND_SOCKET="$WAYLAND_DISPLAY" ;;
    *)  WAYLAND_SOCKET="${XDG_RUNTIME_DIR:-}/$WAYLAND_DISPLAY" ;;
  esac
  if [ -S "$WAYLAND_SOCKET" ]; then
    WAYLAND_OK=1
  elif [ -n "${DISPLAY:-}" ]; then
    echo "AutoAgent: Wayland socket $WAYLAND_SOCKET is missing; falling back to X11 ($DISPLAY)" >>"$LOG_FILE"
  else
    echo "AutoAgent: Wayland socket $WAYLAND_SOCKET is missing and DISPLAY is not set" >&2
    exit 1
  fi
fi

if [ "$WAYLAND_OK" -eq 1 ]; then
  echo "AutoAgent: launching on Wayland ($WAYLAND_DISPLAY)" >>"$LOG_FILE"
  exec "$ELECTRON" --ozone-platform=wayland "$DESKTOP_APP" "$@" >>"$LOG_FILE" 2>&1
fi

if [ -z "${DISPLAY:-}" ]; then
  echo "AutoAgent: no display available (set DISPLAY or WAYLAND_DISPLAY)" >&2
  exit 1
fi

echo "AutoAgent: launching on X11 ($DISPLAY)" >>"$LOG_FILE"
exec "$ELECTRON" "$DESKTOP_APP" "$@" >>"$LOG_FILE" 2>&1
