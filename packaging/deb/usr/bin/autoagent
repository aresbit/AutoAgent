#!/bin/sh
# AutoAgent launcher. One fixed install root, one Electron binary, no PATH
# search; the Chromium sandbox stays enabled.
set -eu
umask 077

APP_DIR="${AUTOAGENT_APP_DIR:-/opt/autoagent}"
ELECTRON="$APP_DIR/desktop/electron"
DESKTOP_APP="$APP_DIR/desktop/resources/app"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/autoagent"
LOG_DIR="$STATE_HOME/logs"
LOG_FILE="$LOG_DIR/desktop.log"

export AUTOAGENT_APP_DIR="$APP_DIR"
export AUTOAGENT_PACKAGED=1
export AUTOAGENT_ENGINE_DIR="${AUTOAGENT_ENGINE_DIR:-$APP_DIR/engine}"
export AUTOAGENT_BUN_PATH="${AUTOAGENT_BUN_PATH:-$AUTOAGENT_ENGINE_DIR/bun}"
export AUTOAGENT_OPENCC_CLI_PATH="${AUTOAGENT_OPENCC_CLI_PATH:-$AUTOAGENT_ENGINE_DIR/opencc-dist/cli.js}"
export AUTOAGENT_FRONTEND_DIST="${AUTOAGENT_FRONTEND_DIST:-$APP_DIR/frontend/dist}"
# Do not set AUTOAGENT_ENGINE: the backend defaults to "matebot" in packaged
# mode and loads the vendored module by path.
export AUTOAGENT_MATEBOT_VENDOR_DIR="${AUTOAGENT_MATEBOT_VENDOR_DIR:-$APP_DIR/vendor/matebot}"

[ -x "$ELECTRON" ] || { echo "AutoAgent: missing $ELECTRON" >&2; exit 1; }
[ -f "$DESKTOP_APP/entry.js" ] || { echo "AutoAgent: missing $DESKTOP_APP/entry.js" >&2; exit 1; }
[ -x "$AUTOAGENT_BUN_PATH" ] || { echo "AutoAgent: missing $AUTOAGENT_BUN_PATH" >&2; exit 1; }
[ -f "$AUTOAGENT_OPENCC_CLI_PATH" ] || { echo "AutoAgent: missing $AUTOAGENT_OPENCC_CLI_PATH" >&2; exit 1; }
[ -f "$AUTOAGENT_FRONTEND_DIST/index.html" ] || { echo "AutoAgent: missing $AUTOAGENT_FRONTEND_DIST/index.html" >&2; exit 1; }
[ -f "$AUTOAGENT_MATEBOT_VENDOR_DIR/opencc_backend.py" ] || { echo "AutoAgent: missing $AUTOAGENT_MATEBOT_VENDOR_DIR/opencc_backend.py" >&2; exit 1; }

mkdir -p "$LOG_DIR"

WAYLAND_OK=0
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  case "$WAYLAND_DISPLAY" in
    /*) WAYLAND_SOCKET="$WAYLAND_DISPLAY" ;;
    *)  WAYLAND_SOCKET="${XDG_RUNTIME_DIR:-}/$WAYLAND_DISPLAY" ;;
  esac
  if [ -S "$WAYLAND_SOCKET" ]; then
    WAYLAND_OK=1
  elif [ -n "${DISPLAY:-}" ]; then
    echo "AutoAgent: Wayland socket $WAYLAND_SOCKET is missing; falling back to X11 ($DISPLAY)" >>"$LOG_FILE"
  else
    echo "AutoAgent: Wayland socket $WAYLAND_SOCKET is missing and DISPLAY is not set" >&2
    exit 1
  fi
fi

if [ "$WAYLAND_OK" -eq 1 ]; then
  echo "AutoAgent: launching on Wayland ($WAYLAND_DISPLAY)" >>"$LOG_FILE"
  exec "$ELECTRON" --ozone-platform=wayland "$DESKTOP_APP" "$@" >>"$LOG_FILE" 2>&1
fi

if [ -z "${DISPLAY:-}" ]; then
  echo "AutoAgent: no display available (set DISPLAY or WAYLAND_DISPLAY)" >&2
  exit 1
fi

echo "AutoAgent: launching on X11 ($DISPLAY)" >>"$LOG_FILE"
exec "$ELECTRON" "$DESKTOP_APP" "$@" >>"$LOG_FILE" 2>&1
