{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/.bun/electron@41.3.0/node_modules/@types"
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.mjs"],
  "exclude": ["dist", "node_modules", "src/entry.ts"]
}
