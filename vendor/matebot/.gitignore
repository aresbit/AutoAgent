workspace/memory/

# Vendored CLI build (25MB blob).
# NOTE: vendor/opencc is currently committed as a gitlink (mode 160000) with no
# .gitmodules entry, so a fresh clone gets an EMPTY vendor/opencc/ — which is
# why the default CLI path never resolved. This ignore only takes effect after
# `git rm --cached vendor/opencc`.
vendor/opencc/.cosyvoice/
vendor/cosyvoice/
